PORT=3000
BACKEND_BEARER_TOKEN=replace-with-a-random-token-of-at-least-32-characters
EMAIL_TRANSPORT=google_apps_script
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/replace-with-deployment-id/exec
GOOGLE_APPS_SCRIPT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SMTP_FROM_EMAIL=replace-with-the-google-sender-address
SMTP_FROM_NAME=Voice Recorder Plus

# Brevo HTTPS API remains supported.
BREVO_API_KEY=replace-with-brevo-api-key

# SMTP is supported on hosts that allow outbound SMTP ports.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-brevo-smtp-login
SMTP_PASS=replace-with-brevo-smtp-key
