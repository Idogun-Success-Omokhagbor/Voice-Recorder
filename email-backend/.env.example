PORT=3000
BACKEND_BEARER_TOKEN=replace-with-a-random-token-of-at-least-32-characters
EMAIL_TRANSPORT=api
BREVO_API_KEY=replace-with-brevo-api-key
SMTP_FROM_EMAIL=replace-with-a-verified-brevo-sender
SMTP_FROM_NAME=Voice Recorder Plus

# SMTP is supported on hosts that allow outbound SMTP ports.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-brevo-smtp-login
SMTP_PASS=replace-with-brevo-smtp-key
